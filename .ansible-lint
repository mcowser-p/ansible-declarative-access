# .ansible-lint configuration
# https://ansible-lint.readthedocs.io/en/latest/

# Skip specific rules
# skip_list:
  # - yaml
  # - name[prefix]
  # - role-name

# Exclude paths
exclude_paths:
  - .claude/
  - .github/workflows/
  - molecule/
  - tests/
  - venv/
  - .venv/
  # transient dirs produced by local molecule runs (ANSIBLE_HOME: ../../)
  - tmp/
  - roles/declarative_access/tmp/
  - .ansible/

# Use specific profile
profile: min
